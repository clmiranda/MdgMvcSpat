<Project>

  <!--
    Gestión central de paquetes (Central Package Management).
    Las versiones se declaran SOLO aquí; los .csproj usan PackageReference sin Version.
    Las versiones actuales se mantienen sin cambios: se actualizan o retiran en la Fase 1
    (ver docs/MODERNIZATION.md).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="ClosedXML" Version="0.95.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="RestSharp" Version="106.11.7" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

</Project>
