<Project>

  <!--
    Gestión central de paquetes (Central Package Management).
    Las versiones se declaran SOLO aquí; los .csproj usan PackageReference sin Version.
    Las versiones actuales se mantienen sin cambios: se actualizan o retiran en la Fase 1
    (ver docs/MODERNIZATION.md).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="ClosedXML" Version="0.95.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="3.1.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Http" Version="2.2.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="2.2.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="2.2.6" />
    <PackageVersion Include="Newtonsoft.Json" Version="12.0.3" />
    <PackageVersion Include="RestSharp" Version="106.11.7" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="6.8.0" />
  </ItemGroup>

</Project>
